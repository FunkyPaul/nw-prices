# Domain, unter der die Seite erreichbar sein soll (DNS-A-Record muss auf den VPS zeigen).
# Caddy holt sich dafuer automatisch ein HTTPS-Zertifikat.
NWP_DOMAIN=preise.example.de

# Admin-Login: nur der Admin kann hochladen, loeschen und Shop-Preise aendern. Ansehen kann jeder.
# Unbedingt ein langes Passwort setzen (z. B. openssl rand -base64 24)! Ohne Passwort ist die Seite nur lesbar.
NWP_USER=paul
NWP_PASSWORD=bitte-aendern

# 1 = ganze Seite nur nach Login sichtbar (Standard: oeffentlich lesbar)
NWP_PRIVATE=0

# Maximale Upload-Groesse in MB
NWP_MAX_UPLOAD_MB=500

# Sprache der Kommandozeilen-Ausgabe (en oder de). Die Web-Oberflaeche hat einen eigenen Umschalter.
NWP_LANG=en

# Icons fuer die Tooltip-Karten: werden einmal von nw-buddy geladen und in /data/icons gespeichert.
# "off" schaltet das Laden ab.
NWP_ICON_CDN=https://cdn.nw-buddy.de/nw-data/live/
